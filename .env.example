PORT=8791
SITE_URL=http://localhost:8791

# --- reuse from ~/Documents/lostfound/.env ---
HELIUS_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# optional: ASSET_STORE=pinata to pin to IPFS; default stores icons/metadata on our disk at SITE_URL/a/
ASSET_STORE=local
PINATA_JWT=
PINATA_GATEWAY=

# the house: pays distribution network fees, receives the devs cut. make a FRESH wallet for this before launch.
HOUSE_WALLET=
HOUSE_WALLET_SECRET=

# fee split on every coin a dev launches, in bps. boss gets the rest (7000).
FEE_DEV_BPS=2000
FEE_HOUSE_BPS=1000
HIRE_SOL=0.5          # recommended budget (default in the form)
HIRE_MIN=0.1          # floor
DEVS_SLICE=0.25       # share of each dev's own cut that buys $DEVS
SOL_USD=180
ADMIN_KEY=

# X: console.x.com → your app → Keys and tokens. v1 posts from one project account.

# once $DEVS exists
PLATFORM_MINT=        # $DEVS mint (launch it from the house wallet under DBC_CONFIG)
PLATFORM_POOL=        # its DBC pool address. devs buy $DEVS here; its creator fees fund the devs

# Meteora DBC partner config (one-time: node scripts/partner-config.js)
DBC_CONFIG=
